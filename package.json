{
  "name": "pi-guy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opinionated Pi extensions",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "node --test --test-force-exit \"tests/**/*.test.ts\" \"statusline/tests/*.test.ts\" \"subagents/tests/*.test.ts\" \"working-indicator/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24",
    "typebox": "1.3.27",
    "typescript": "^5"
  }
}
