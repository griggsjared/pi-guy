{
  "name": "pi-guy",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Opinionated Pi extensions",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "test": "node --test --test-force-exit \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "knip": "knip",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm test",
    "fix": "oxlint --type-aware --fix src tests && oxfmt src tests"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "^24",
    "knip": "^6.44.1",
    "oxfmt": "0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typebox": "1.3.27",
    "typescript": "^5"
  }
}
